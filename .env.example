# Copy to .env.local and fill in. Never commit real values.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon (or "publishable") key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by /api routes that call Claude.
ANTHROPIC_API_KEY=

# Optional: canonical URL used in invite links (defaults to the request host).
NEXT_PUBLIC_SITE_URL=
